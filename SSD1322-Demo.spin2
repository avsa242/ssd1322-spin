{
----------------------------------------------------------------------------------------------------
    Filename:       SSD1322-Demo.spin2
    Description:    Demo of the SSD1322 driver
    Author:         Jesse Burt
    Started:        Jan 15, 2024
    Updated:        Mar 7, 2025
    Copyright (c) 2025 - See end of file for terms of use.
----------------------------------------------------------------------------------------------------
}

CON

    _clkfreq    = 180_000_000
    _xtlfreq    = 20_000_000


OBJ

    fnt:    "font.5x8"
    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000
    disp:   "display.oled.ssd1322" | CS=0, SCK=1, MOSI=2, DC=3, RST=4, WIDTH=256, HEIGHT=64, ...
                                        SPI_FREQ=10_000_000


PUB setup()

    ser.start()
    ser.clear()
    ser.strln(@"Serial terminal started")

    if ( disp.start() )
        ser.strln(@"SSD1322 driver started")
        disp.set_font(fnt.ptr(), fnt.setup())
        disp.char_attrs(disp.TERMINAL)
    else
        ser.strln(@"SSD1322 driver failed to start - halting")
        repeat

    ' Choose a preset appropriate to your display (must match resolution set in OBJ line)
    'disp.preset_newhaven_2p7_128x64()
    disp.preset_newhaven_3p12_256x64()

    ' optionally change these to match the orientation of your display
    'disp.mirror_h(false)
    'disp.mirror_v(false)

    _time := 5_000                              ' runtime of each demo (ms)

    demo()


DAT

    _drv_name   byte "SSD1322", 0


#include "GFXDemo-common.spin2h"


DAT
