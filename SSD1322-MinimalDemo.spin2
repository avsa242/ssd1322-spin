----------------------------------------------------------------------------------------------------
}

CON

    _clkfreq    = 180_000_000
    _xtlfreq    = 20_000_000


OBJ

    fnt:    "font.5x8"
    disp:   "display.oled.ssd1322" | WIDTH=256, HEIGHT=64, CS=0, SCK=1, MOSI=2, DC=3, RST=4


PUB main()

   
    disp.start()

    { configure the display with the minimum required setup:
        1. Use a common settings preset for 128x or 256x displays
        2. Tell the driver where to find the font setup }

    ' Choose a preset appropriate to your display (must match resolution set in OBJ line)
    'disp.preset_newhaven_2p7_128x64()
    disp.preset_newhaven_3p12_256x64()

    ' optionally change these to match the orientation of your display
    'disp.mirror_h(false)
    'disp.mirror_v(false)
 
    disp.set_font(fnt.ptr(), fnt.setup())
    disp.clear()

    { draw some text }
    disp.pos_xy(0, 0)
    disp.fgcolor(15)
    disp.strln(@"Testing 12345")


    { draw one pixel at the center of the screen }
    {   disp.plot(x, y, color) }
    disp.plot(disp.CENTERX, disp.CENTERY, 15)

    { draw a box at the screen edges }
    {   disp.box(x_start, y_start, x_end, y_end, color, filled) }
    disp.box(0, 0, disp.XMAX, disp.YMAX, 15, false)

    disp.show()                                 ' send the buffer to the display after everything
                                                '   has been drawn

    repeat


DAT
